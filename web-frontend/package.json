{
  "name": "mainpg-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:api-proxy": "node scripts/check-api-paths.mjs",
    "build": "node scripts/check-api-paths.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "verify": "node scripts/check-api-paths.mjs && node --experimental-strip-types --test \"src/**/*.test.ts\" && tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "driver.js": "^1.8.0",
    "konva": "^10.3.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
