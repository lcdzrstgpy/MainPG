{
  "manifest_version": 3,
  "name": "TEMU Y2 AI Workbench Connector",
  "version": "0.1.124",
  "description": "Connects logged-in TEMU/Dianxiaomi pages to the AI workbench without storing platform credentials.",
  "permissions": ["activeTab", "storage", "scripting", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://amazon.com/*",
    "https://*.amazon.com/*",
    "https://*.media-amazon.com/*",
    "https://*.1688.com/*",
    "https://*.alibaba.com/*",
    "https://*.alicdn.com/*",
    "https://*.temaishuju.com/*",
    "https://*.kwcdn.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*",
    "https://*.temu.com/*",
    "https://*.dianxiaomi.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TEMU Y2 AI Workbench"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.temu.com/*", "https://*.dianxiaomi.com/*", "https://amazon.com/*", "https://*.amazon.com/*", "https://*.1688.com/*", "https://*.alibaba.com/*", "https://*.temaishuju.com/*", "https://*.pinduoduo.com/*", "https://*.yangkeduo.com/*"],
      "js": ["network_probe_utils.js", "page_probe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.temu.com/*", "https://*.dianxiaomi.com/*", "https://amazon.com/*", "https://*.amazon.com/*", "https://*.1688.com/*", "https://*.alibaba.com/*", "https://*.temaishuju.com/*", "https://*.pinduoduo.com/*", "https://*.yangkeduo.com/*"],
      "js": ["tenant_context.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

