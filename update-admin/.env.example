# 仅作为变量说明；不要把真实密码或私钥提交到代码仓库。
UPDATE_ADMIN_DATA_DIR=/var/lib/mainpg-update-admin
UPDATE_PUBLISH_DIR=/var/www/html/mainpg/windows
UPDATE_PUBLIC_BASE_URL=https://workbench.haocoming.top/mainpg/windows
UPDATE_SIGNING_KEY_PATH=/etc/mainpg-update-admin/release-ed25519.pem
UPDATE_EXPECTED_PUBLIC_KEY_B64=replace-with-client-public-key
UPDATE_ADMIN_INITIAL_PASSWORD=replace-before-first-start
UPDATE_ADMIN_BOSS_INITIAL_PASSWORD=replace-before-first-start
UPDATE_ADMIN_SECURE_COOKIE=1
UPDATE_ADMIN_COOKIE_PATH=/update-admin
UPDATE_REQUIRE_AUTHENTICODE=0
# 有 Windows 代码签名证书并开启严格校验后再设置为 1。
# UPDATE_REQUIRE_AUTHENTICODE=1
# UPDATE_EXPECTED_AUTHENTICODE_PUBLISHER=Your Company Name

# EV Sign 自动签名。许可证只能存放在服务器私密环境文件中。
EVSIGN_API_URL=https://api.evsign.cn/v1
EVSIGN_LICENSE_KEY=replace-with-rotated-license-key
EVSIGN_REQUIRED=1
EVSIGN_TIMEOUT_SECONDS=900

# Incremental patches are normally embedded by build_installer.ps1. innoextract
# is only a compatibility fallback for older installers that it can parse.
UPDATE_PATCH_ENABLED=1
UPDATE_INNOEXTRACT_PATH=/usr/bin/innoextract
UPDATE_PATCH_EXTRACT_TIMEOUT_SECONDS=600
UPDATE_PATCH_MAX_EXTRACTED_BYTES=4000000000
