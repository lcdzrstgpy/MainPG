# 妙手导出的运行时产物：精简模板缓存与参考表由程序首次导出时自动生成
local-runtime/wh_local/modules/product_processing/templates/generated/
local-runtime/wh_local/modules/product_processing/templates/妙手参考表-类目ID与包装清单.xlsx

# 嵌入式 Python 运行时（打包用，体积大，不进 git）
local-runtime/python-runtime/

# 运行时日志
*.log

# 测试临时目录
local-runtime/.pytest-*/

# 本地备份
_backup/

# Local tooling
local-runtime/python.exe
.trae/
product_processing.db

# 公告发布后台本地数据
announcement-admin/announcements.sqlite3
announcement-admin/config.json

# 运行时输出与锁文件
real-workbench/employee_workbench/product_processing/
*.lock
!package-lock.json
!yarn.lock
!pnpm-lock.yaml

# pytest 残留目录（ACL 损坏，git 无法遍历，避免 warning）
.pytest-update-admin-*/

# 项目工作数据
.workbuddy/

# 测试残留的临时 SQLite 文件
NONEXISTENT-NO-DB

# 本地运行时业务日志（login.log / ai_processing.log / pod_processing.log / runtime.log）
local-runtime/*.log

# 本机一次性排查/迁移脚本与临时产物（不要进 git，仓库里只留可复用的源码）
local-runtime/_*
local-runtime/probe2.spec
local-runtime/qt_probe.spec
local-runtime/qt_probe_win.spec
local-runtime/launch_dbg.spec
local-runtime/launch_onedir.spec
local-runtime/update-snooze.json
_changed_*.txt
_internal_dl.bin
combo_backend.patch
debug-*.md
launcher_screenshot*.png
*.merge-bak
~$*
W-H-*.zip

# 测试运行残留（每次跑 pytest 都会生成，含临时 SQLite，体积可达数百 MB）
local-runtime/.tmp_bt_*/
local-runtime/.tmp_pytest*/
local-runtime/.pytest_tmp/
# 运行期临时会话文件（文件名本身就是一个奇怪的字面量）
local-runtime/:memory:.ses
# Vite 热更新产生的时序文件
web-frontend/*.timestamp-*.mjs
